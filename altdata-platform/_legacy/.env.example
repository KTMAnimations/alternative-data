# Alternative Data Platform Configuration
# Copy this file to .env and fill in your values

# ===========================================
# ENVIRONMENT
# ===========================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL with TimescaleDB
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/altdata_dev
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# STORAGE (Raw Data Lake)
# ===========================================
# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET=altdata-raw-data

# OR Google Cloud Storage
# GCS_PROJECT_ID=your-project
# GCS_BUCKET=altdata-raw-data
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# OR Local filesystem (development)
LOCAL_STORAGE_PATH=./data/raw

# ===========================================
# API CONFIGURATION
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# API Keys for clients
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=your-admin-api-key
API_KEY_DEFAULT=your-default-api-key

# ===========================================
# EXTERNAL API KEYS
# ===========================================

# SEC EDGAR
# Format: "Your Name your@email.com"
# Required to identify yourself to SEC servers
SEC_EDGAR_USER_AGENT=YourName your@email.com

# FRED (Federal Reserve Economic Data)
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# ADS-B Exchange
# Get key at: https://www.adsbexchange.com/data/
ADSB_EXCHANGE_API_KEY=your-adsb-api-key
ADSB_EXCHANGE_RAPIDAPI_KEY=your-rapidapi-key

# OpenAQ
# Get key at: https://openaq.org/developers/
OPENAQ_API_KEY=your-openaq-api-key

# USPTO (Patent data)
# Get key at: https://developer.uspto.gov/
USPTO_API_KEY=your-uspto-api-key

# ===========================================
# OPTIONAL: TIER 2 DATA SOURCES
# ===========================================

# Reddit API
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_USER_AGENT=altdata-platform:v1.0 (by /u/yourusername)

# GitHub API
# Create token at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token

# ===========================================
# COLLECTOR SETTINGS
# ===========================================
# How often to run collectors (cron expression or seconds)
SEC_EDGAR_INTERVAL=300
FRED_INTERVAL=3600
ADSB_INTERVAL=60

# Rate limiting (requests per second)
SEC_EDGAR_RATE_LIMIT=10
FRED_RATE_LIMIT=2

# ===========================================
# MONITORING (Optional)
# ===========================================
# Sentry for error tracking
# SENTRY_DSN=https://key@sentry.io/project

# Prometheus metrics
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Use local filesystem instead of S3/GCS
USE_LOCAL_STORAGE=true

# Skip rate limiting for testing
SKIP_RATE_LIMITS=false

# Mock external APIs for testing
MOCK_EXTERNAL_APIS=false
